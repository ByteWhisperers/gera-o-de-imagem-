{
  "mcpServers": {
    "comfyui": {
      "command": "comfy-mcp"
    },
    "photocraft": {
      "command": "photocraft-cli",
      "args": ["mcp", "--automation-read-root", ".", "--automation-write-root", "saida"]
    },
    "photocraft-app": {
      "command": "photocraft-cli",
      "args": ["mcp", "--bridge", "127.0.0.1:7878", "--control-token-file", "/caminho/privado/photocraft-control.token"]
    }
  }
}
